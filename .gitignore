venv/

# Version the datasets required by the synthetic-vs-real notebook.
# CSV files elsewhere remain ignored by the repository-wide *.csv rule.
!data/**/*.csv

# Share immutable, hash-addressed PPO training caches across machines.
# Keep smoke runs and other generated results local.

# results/
# └── ppo_synthetic_vs_real/
#     ├── smoke/       ignored
#     ├── full/        ignored
#     └── train_cache/ tracked

results/*
!results/ppo_synthetic_vs_real/
results/ppo_synthetic_vs_real/*
!results/ppo_synthetic_vs_real/train_cache/
!results/ppo_synthetic_vs_real/train_cache/**

# Share the intrinsic-reward semantic training cache across machines while
# keeping smoke/full reports and duplicated experiment artifacts local.
!results/finrl_intrinsic_reward_ablation/
results/finrl_intrinsic_reward_ablation/*
!results/finrl_intrinsic_reward_ablation/train_cache/
!results/finrl_intrinsic_reward_ablation/train_cache/**
